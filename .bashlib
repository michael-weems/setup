#!/usr/bin/env bash

export argv=("$@")
export argc=${#argv[@]}

dry="false"
usage="false"

for ((i=0; i<argc; i++)); do
	if   [[ "-d" == "${argv[$i]}" ]] || [[ "--dry" == "${argv[$i]}" ]]; then
		dry="true"
	elif [[ "-h" == "${argv[$i]}" ]] || [[ "--help" == "${argv[$i]}" ]]; then
		usage="true"
	fi
done
export dry
export usage

_lib_usage() {
	echo "-d, --dry-run   | perform a dry-run of the operations"
	echo "-h, --help      | print usage"
}
export -f _lib_usage
